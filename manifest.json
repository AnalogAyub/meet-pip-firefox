{
  "manifest_version": 2,
  "name": "Meet PiP for Firefox",
  "version": "0.4.4",
  "description": "Replicates Google Meet's Chrome picture-in-picture: composites the presentation and participant videos into one video that Firefox's native PiP can pop out, with the PiP mute/pause buttons wired to the Meet mic and camera.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "meet-pip@local.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
